# =============================================================================
# Telegram Video Downloader Bot - configuration
# Copy to .env and fill in what you need. Everything except the token is optional.
# =============================================================================

# --- Required ----------------------------------------------------------------

# Telegram Bot Token - get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here


# --- Storage -----------------------------------------------------------------

# Where videos are downloaded before being uploaded. Defaults to a
# "telegram-video-bot" folder inside the system temp directory.
# DOWNLOAD_DIR=/Users/yourname/downloads/telegram-videos

# Delete leftover files older than this many hours on startup. 0 disables it.
# CLEANUP_MAX_AGE_HOURS=6


# --- Size limits -------------------------------------------------------------

# api.telegram.org caps bot uploads at 50MB. Point this at a self-hosted Bot API
# server (https://github.com/tdlib/telegram-bot-api) to raise that to 2GB;
# MAX_UPLOAD_SIZE_MB then defaults to 2000.
# TELEGRAM_API_BASE_URL=http://localhost:8081

# Hard ceiling for uploads. Defaults to 50 (or 2000 with a local Bot API server).
# MAX_UPLOAD_SIZE_MB=50

# Reject videos estimated above this before downloading. Defaults to MAX_UPLOAD_SIZE_MB.
# MAX_DOWNLOAD_SIZE_MB=50

# Upper bound on the requested video height.
# MAX_VIDEO_HEIGHT=1080

# Private chat IDs allowed to exceed MAX_DOWNLOAD_SIZE_MB (comma separated).
# Only useful together with a local Bot API server.
# PRIVATE_CHAT_IDS=123456789,987654321


# --- Behaviour ---------------------------------------------------------------

# Tag that opts a group message into downloading.
# DOWNLOAD_TAG=#download

# Platforms downloaded in groups without the tag (comma separated).
# GROUP_AUTO_PLATFORMS=tiktok

# Reply with a hint when a group message has a supported link but no tag.
# HINT_ON_UNTAGGED_LINKS=false

# Reply with an explanation when a private-chat link is not supported.
# REPLY_ON_UNSUPPORTED_LINKS=true

# Attach a generated poster frame to videos (requires ffmpeg).
# GENERATE_THUMBNAILS=true


# --- Performance -------------------------------------------------------------

# Downloads running at the same time across all chats.
# MAX_CONCURRENT_DOWNLOADS=3

# Parallel fragment downloads for HLS/DASH sources.
# CONCURRENT_FRAGMENTS=4

# Seconds before a single download / upload attempt is abandoned.
# DOWNLOAD_TIMEOUT_SECONDS=900
# UPLOAD_TIMEOUT_SECONDS=300

# Attempts per upload before giving up.
# MAX_UPLOAD_RETRIES=3

# Minimum seconds between progress message edits (Telegram rate limits edits).
# PROGRESS_UPDATE_INTERVAL=4

# yt-dlp network settings.
# SOCKET_TIMEOUT_SECONDS=30
# DOWNLOAD_RETRIES=3


# --- Authentication / tooling ------------------------------------------------

# Netscape-format cookie file for logged-in downloads (Instagram, Facebook...).
# COOKIE_FILE=/path/to/cookies.txt

# Or let yt-dlp read cookies straight from a browser profile, e.g. "chrome"
# or "firefox:default-release".
# COOKIES_FROM_BROWSER=chrome

# Explicit ffmpeg directory when it is not on PATH.
# FFMPEG_LOCATION=/opt/homebrew/bin


# --- Logging -----------------------------------------------------------------

# DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# Also write logs to a file.
# LOG_FILE=bot.log
