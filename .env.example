# Telegram Bot Token
# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Optional: Set download directory
# DOWNLOAD_DIR=/path/to/downloads

# Optional: Comma-separated list of private chat IDs that can download videos of any size
# These IDs will bypass the 50MB size limit when in private chats
# PRIVATE_CHAT_IDS=123456789,987654321

