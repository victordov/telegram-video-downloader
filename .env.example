# =============================================================================
# Telegram Video Downloader Bot - configuration
# Copy to .env and fill in what you need. Everything except the token is optional.
# =============================================================================

# --- Required ----------------------------------------------------------------

# Telegram Bot Token - get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here


# --- Access ------------------------------------------------------------------

# Who may use the bot (comma separated user or chat IDs). Empty = everyone.
# A group's ID (negative, e.g. -1001234567890) lets everyone in that group use
# it, in the group and in their private chat with the bot or inline; a user's
# ID lets them use it in any chat. Privileged and admin IDs are always allowed.
# When anyone else tries the bot, the admins get an Allow / Ignore prompt, and
# /access lists and undoes those decisions.
# ALLOWED_CHAT_IDS=123456789,-1001234567890

# Who gets breakage alerts and may run /update. Defaults to PRIVATE_CHAT_IDS.
# ADMIN_CHAT_IDS=123456789

# Downloads each user may start per hour (0 = unlimited). Admins and privileged
# chats are exempt, and links answered from the cache do not count.
# RATE_LIMIT_PER_HOUR=20

# Tell strangers in a private chat that the bot is private.
# REPLY_TO_UNAUTHORIZED=true

# Send the admins an Allow / Ignore prompt for chats outside the allow list
# (at most once a day per chat).
# NOTIFY_ACCESS_REQUESTS=true


# --- Storage -----------------------------------------------------------------

# Where videos are downloaded before being uploaded. Defaults to a
# "telegram-video-bot" folder inside the system temp directory.
# DOWNLOAD_DIR=/Users/yourname/downloads/telegram-videos

# Delete leftover files older than this many hours on startup. 0 disables it.
# CLEANUP_MAX_AGE_HOURS=6

# SQLite file for the media cache, statistics and button links. Keep it local:
# it records which chats used the bot. Defaults to data/bot.sqlite3.
# DATABASE_PATH=/path/to/bot.sqlite3

# Resend links that were already uploaded instead of downloading them again,
# for this many days. 0 disables the cache.
# CACHE_TTL_DAYS=30


# --- Size limits -------------------------------------------------------------

# api.telegram.org caps bot uploads at 50MB. Point this at a self-hosted Bot API
# server (https://github.com/tdlib/telegram-bot-api) to raise that to 2GB;
# MAX_UPLOAD_SIZE_MB then defaults to 2000.
# TELEGRAM_API_BASE_URL=http://localhost:8081

# Hard ceiling for uploads. Defaults to 50 (or 2000 with a local Bot API server).
# MAX_UPLOAD_SIZE_MB=50

# Reject videos estimated above this before downloading. Defaults to MAX_UPLOAD_SIZE_MB.
# MAX_DOWNLOAD_SIZE_MB=50

# Upper bound on the requested video height.
# MAX_VIDEO_HEIGHT=1080

# Re-encode videos that come out above the upload limit so they still fit
# (requires ffmpeg). Videos too long to fit at a watchable quality are refused.
# COMPRESS_OVERSIZED=true

# Do not download more than this many MB just to shrink it afterwards.
# COMPRESS_MAX_SOURCE_MB=400

# Height used by the "🔁 HD" button (privileged chats). Above 1080 most sites
# only serve VP9/AV1, which would need a slow re-encode for Apple devices.
# HD_MAX_HEIGHT=1080

# Private chat IDs allowed to exceed MAX_DOWNLOAD_SIZE_MB (comma separated).
# They also get the HD button and skip the rate limit. Bigger files only
# upload with a local Bot API server.
# PRIVATE_CHAT_IDS=123456789,987654321


# --- Behaviour ---------------------------------------------------------------

# Tag that opts a group message into downloading.
# DOWNLOAD_TAG=#download

# Platforms downloaded in groups without the tag (comma separated).
# GROUP_AUTO_PLATFORMS=tiktok

# Reply with a hint when a group message has a supported link but no tag.
# HINT_ON_UNTAGGED_LINKS=false

# Reply with an explanation when a private-chat link is not supported.
# REPLY_ON_UNSUPPORTED_LINKS=true

# In private chats (and with /dl), also try links from any other site yt-dlp
# has an extractor for (BBC, Bilibili, SoundCloud, ...).
# TRY_ANY_LINK=true

# Most items sent from one multi-item post (Instagram carousel, TikTok photos,
# tweet with several videos). Telegram albums hold up to 10.
# MAX_ALBUM_ITEMS=10

# Caption extras: the author (linked), the post text as a collapsed quote, and
# a spoiler blur on media the site marks as 18+.
# CAPTION_AUTHOR=true
# CAPTION_DESCRIPTION=true
# SPOILER_ADULT_CONTENT=true

# Inline mode (@yourbot <link> in any chat) shares videos the bot already has.
# Enable it with @BotFather -> /setinline. For links it has not seen yet, set a
# chat to upload into in the background (a private channel with the bot as
# admin); without one, users get a button to download in a private chat first.
# CACHE_CHAT_ID=-1001234567890

# Attach a generated poster frame to videos (requires ffmpeg).
# GENERATE_THUMBNAILS=true

# Normalize downloads to H.264/AAC MP4 (requires ffmpeg). WebM's VP9/AV1 video
# and Opus audio do not play on iPhone or macOS. Streams already in an Apple
# codec are copied, not re-encoded, so this is usually near-free. Set to false
# to keep whatever the site served.
# FORCE_MP4=true


# --- Performance -------------------------------------------------------------

# Downloads running at the same time across all chats.
# MAX_CONCURRENT_DOWNLOADS=3

# Parallel fragment downloads for HLS/DASH sources.
# CONCURRENT_FRAGMENTS=4

# Seconds before a single download / upload attempt is abandoned.
# DOWNLOAD_TIMEOUT_SECONDS=900
# UPLOAD_TIMEOUT_SECONDS=300

# Attempts per upload before giving up.
# MAX_UPLOAD_RETRIES=3

# Minimum seconds between progress message edits (Telegram rate limits edits).
# PROGRESS_UPDATE_INTERVAL=4

# yt-dlp network settings.
# SOCKET_TIMEOUT_SECONDS=30
# DOWNLOAD_RETRIES=3


# --- Authentication / tooling ------------------------------------------------

# Netscape-format cookie file for logged-in downloads (Instagram, Facebook...).
# COOKIE_FILE=/path/to/cookies.txt

# Or let yt-dlp read cookies straight from a browser profile, e.g. "chrome",
# "chrome:Profile 1" or "firefox:default-release". Reddit and Vimeo need this.
# The cookies are read once every few hours and kept in memory; Chrome on
# macOS asks for Keychain access the first time (choose "Always Allow").
# COOKIES_FROM_BROWSER=chrome

# Send the cookies only to sites that ask for a login. Other sites stay
# anonymous, so your accounts are not tied to everything the bot downloads.
# COOKIES_ONLY_WHEN_NEEDED=true

# When plain DNS is blocked (some VPNs such as Tailscale, corporate networks),
# TikTok and other sites fail with "Could not resolve host". The bot then
# switches yt-dlp to this DNS-over-HTTPS server. Empty turns it off.
# DNS_FALLBACK_DOH_URL=https://1.1.1.1/dns-query

# Explicit ffmpeg directory when it is not on PATH.
# FFMPEG_LOCATION=/opt/homebrew/bin


# --- Maintenance -------------------------------------------------------------

# Update yt-dlp in place every YTDLP_UPDATE_INTERVAL_HOURS and restart once
# downloads finish. Skipped when site-packages is read-only (the Docker image);
# rebuild the image there instead. Admins can also send /update.
# YTDLP_AUTO_UPDATE=true
# YTDLP_UPDATE_INTERVAL_HOURS=168

# /status warns when the installed yt-dlp is older than this many days.
# YTDLP_STALE_DAYS=30

# Message the admins after this many failures in a row from one site, at most
# once per cooldown.
# ALERT_FAILURE_THRESHOLD=3
# ALERT_COOLDOWN_MINUTES=60


# --- Webhook (servers) -------------------------------------------------------

# Public HTTPS address Telegram pushes updates to. Empty = poll (fine on a
# laptop). Put a reverse proxy with TLS in front of WEBHOOK_PORT.
# WEBHOOK_URL=https://bot.example.com
# WEBHOOK_LISTEN=0.0.0.0
# WEBHOOK_PORT=8443
# WEBHOOK_PATH=telegram

# Secret Telegram echoes back so forged updates are rejected. Defaults to a
# value derived from the token.
# WEBHOOK_SECRET=


# --- Logging -----------------------------------------------------------------

# DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# Also write logs to a file.
# LOG_FILE=bot.log
